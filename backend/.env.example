MONGO_URL=mongodb://localhost:27017
DB_NAME=gaming_portfolio
# Comma-separated frontend origins allowed to call the API (no trailing slashes)
CORS_ORIGINS=http://localhost:3000
# Behind a proxy such as Render, set true so rate limiting sees the real client IP
TRUST_PROXY=false

# --- analytics ---
ANALYTICS_RETENTION_DAYS=180
# Typed free text (e.g. a typed pitch) is NOT stored unless this is true
ANALYTICS_STORE_FREE_TEXT=false

# --- private admin dashboard (disabled until both are set) ---
# Generate with:  backend\.venv\Scripts\python scripts\admin_setup.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
